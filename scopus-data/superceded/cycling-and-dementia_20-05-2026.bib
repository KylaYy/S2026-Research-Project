@ARTICLE{Conceição2021717,
	author = {Conceição, Núbia Ribeiro and Gobbi, Lilian Teresa Bucken and Nóbrega-Sousa, Priscila and Orcioli-Silva, Diego and Beretta, Victor Spiandor and Lirani-Silva, Ellen and Okano, Alexandre Hideki and Vitório, Rodrigo},
	title = {Aerobic Exercise Combined With Transcranial Direct Current Stimulation Over the Prefrontal Cortex in Parkinson Disease: Effects on Cortical Activity, Gait, and Cognition},
	year = {2021},
	journal = {Neurorehabilitation and Neural Repair},
	volume = {35},
	number = {8},
	pages = {717 - 728},
	doi = {10.1177/15459683211019344},
	url = {https://www.scopus.com/pages/publications/85106703475?origin=resultslist},
	affiliations = {São Paulo State University (UNESP), Institute of Biosciences, Graduate Program in Movement Sciences, Rio Claro, SP, Brazil; Oregon Health and Science University, Department of Neurology, Portland, OR, United States; Federal University of ABC (UFABC), Center for Mathematics, Computation and Cognition, São Bernardo do Campo, SP, Brazil},
	abstract = {Background: Since people with Parkinson disease (PD) rely on limited prefrontal executive resources for the control of gait, interventions targeting the prefrontal cortex (PFC) may help in managing PD-related gait impairments. Transcranial direct current stimulation (tDCS) can be used to modulate PFC excitability and improve prefrontal cognitive functions and gait. Objective: We investigated the effects of adding anodal tDCS applied over the PFC to a session of aerobic exercise on gait, cognition, and PFC activity while walking in people with PD. Methods: A total of 20 people with PD participated in this randomized, double-blinded, sham-controlled crossover study. Participants attended two 30-minute sessions of aerobic exercise (cycling at moderate intensity) combined with different tDCS conditions (active- or sham-tDCS), 1 week apart. The order of sessions was counterbalanced across the sample. Anodal tDCS (2 mA for 20 minutes [active-tDCS] or 10 s [sham-tDCS]) targeted the PFC in the most affected hemisphere. Spatiotemporal gait parameters, cognitive functions, and PFC activity while walking were assessed before and immediately after each session. Results: Compared with the pre-assessment, participants decreased step time variability (effect size: −0.4), shortened simple and choice reaction times (effect sizes: −0.73 and −0.57, respectively), and increased PFC activity in the stimulated hemisphere while walking (effect size: 0.54) only after aerobic exercise + active-tDCS. Conclusion: The addition of anodal tDCS over the PFC to a session of aerobic exercise led to immediate positive effects on gait variability, processing speed, and executive control of walking in people with PD. © The Author(s) 2021.},
	author_keywords = {aerobic exercise; cognition; fNIRS; gait; tDCS},
	keywords = {Aged; Cognition; Cross-Over Studies; Double-Blind Method; Exercise; Female; Functional Neuroimaging; Gait; Humans; Male; Mental Status and Dementia Tests; Middle Aged; Parkinson Disease; Prefrontal Cortex; Spectroscopy, Near-Infrared; Transcranial Direct Current Stimulation; Treatment Outcome; Walking; dopamine; levodopa; aerobic exercise; aged; Article; burning sensation; choice reaction time; clinical article; cognition; controlled study; corpus striatum; cortical excitability; crossover procedure; double blind procedure; female; functional near-infrared spectroscopy; gait; heart rate; hemisphere; hemoglobin determination; Hoehn and Yahr scale; Hospital Anxiety and Depression Scale; human; male; MDS-Unified Parkinson Disease Rating Scale; Mini Mental State Examination; moderate intensity exercise; Montreal cognitive assessment; Parkinson disease; prefrontal cortex; pruritus; randomized controlled trial; skin redness; step length; step time; trail making test; transcranial direct current stimulation; walking; cognition; dementia assessment; diagnostic imaging; exercise; functional neuroimaging; gait; middle aged; near infrared spectroscopy; Parkinson disease; pathophysiology; physiology; prefrontal cortex; psychology; treatment outcome},
