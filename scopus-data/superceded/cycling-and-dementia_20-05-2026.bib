@ARTICLE{Yates2025,
	author = {Yates, Brandon A. and Orkaby, Ariela R. and Vingren, Jakob L. and Armstrong, Lawrence E.},
	title = {Low intrinsic capacity is associated with a blunted exercise-induced cognitive enhancement in physically active middle-aged and older adults},
	year = {2025},
	journal = {Alzheimer's and Dementia: Translational Research and Clinical Interventions},
