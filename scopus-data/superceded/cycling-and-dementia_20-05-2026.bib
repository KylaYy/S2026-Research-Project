@ARTICLE{Howland201621,
	author = {Howland, Robert H.},
	title = {Methylene blue: The long and winding road from stain to brain: Part 2},
	year = {2016},
	journal = {Journal of Psychosocial Nursing and Mental Health Services},
	volume = {54},
	number = {10},
	pages = {21 - 26},
	doi = {10.3928/02793695-20160920-04},
