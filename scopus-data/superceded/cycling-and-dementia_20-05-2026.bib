}

@ARTICLE{Pláteník2001445,
	author = {Pláteník, Jan and Stopka, Pavel and Vejrazka, Martin and Stípek, Stanislav},
	title = {Quinolinic acid - Iron(II) complexes: Slow autoxidation, but enhanced hydroxyl radical production in the fenton reaction},
	year = {2001},
	journal = {Free Radical Research},
	volume = {34},
	number = {5},
	pages = {445 - 459},
	doi = {10.1080/10715760100300391},
	url = {https://www.scopus.com/pages/publications/0035000815?origin=resultslist},
	affiliations = {First Institute of Medical Chemistry and Biochemistry, First Faculty of Medicine, Charles University, Prague 2, CZ-12108, Kateñnská 32, Czech Republic; Faculty of Pharmaceutical Sciences, Department of Molecular Pharmacology, Kanazawa University, Kanazawa, Japan; Institute of Inorganic Chemistry, Czech Academy of Sciences, Rez, CZ-250 68, Czech Republic},
	abstract = {Quinolinate (pyridine-2,3-dicarboxylic acid, Quin) is a neurotoxic tryptophan metabolite produced mainly by immune-activated macrophages. It is implicated in the pathogenesis of several brain disorders including HIV-associated dementia. Previous evidence suggests that Quin may exert its neurotoxic effects not only as an agonist on the NMDA subtype of glutamate receptor, but also by a receptor-independent mechanism. In this study we address ability of ferrous quinolinate chelates to generate reactive oxygen species. Autoxidation of Quin-Fe(II) complexes, followed in Hepes buffer at pH 7.4 using ferrozine as the Fe(II) detector, was found to be markedly slower in comparison with iron unchelated or complexed to citrate or ADP. The rate of Quin-Fe(II) autoxidation depends on pH (squared hydroxide anion concentration), is catalyzed by inorganic phosphate, and in both Hepes and phosphate buffers inversely depends on Quin concentration. These observations can be explained in terms of anion catalysis of hexaaquairon(II) autoxidation, acting mainly on the unchelated or partially chelated pool of iron. In order to follow hydroxyl radical generation in the Fenton chemistry, electron paramagnetic resonance (EPR) spin trapping with 5,5-dimethyl-1-pyrroline-N-oxide (DMPO) was employed. In the mixture consisting of 100 mM DMPO, 0.1 mM Fe(II), and 8.8 mM hydrogen peroxide in phosphate buffer pH 7.4, 0.5 mM Quin approximately doubled the yield of DMPO-OH adduct, and higher Quin concentration increased the spin adduct signal even more. When DMPO-OH was pre-formed using Ti<sup>3+</sup>/hydrogen peroxide followed by peroxide removal with catalase, only addition of Quin-Fe(II), but not Fe(II), Fe(III), or Quin-Fe(III), significantly promoted decomposition of pre-formed DMPO-OH. Furthermore, reaction of Quin-Fe(II) with hydrogen peroxide leads to initial iron oxidation followed by appearance of iron redox cycling, detected as slow accumulation of ferrous ferrozine complex. This phenomenon cannot be abolished by subsequent addition of catalase. Thus, we propose that redox cycling of iron by a Quin derivative, formed by initial attack of hydroxyl radicals on Quin, rather than effects of iron complexes on DMPO-OH stability or redox cycling by hydrogen peroxide, is responsible for enhanced DMPO-OH signal in the presence of Quin. The present observations suggest that Quin-Fe(II) complexes display significant pro-oxidant characteristics that could have implications for Quin neurotoxicity.},
	author_keywords = {Excitotoxicity; Iron chelator; Macrophage; Reactive oxygen species},
	keywords = {4 (2 hydroxyethyl) 1 piperazineethanesulfonic acid; 5,5 dimethyl 1 pyrroline 1 oxide; adenosine diphosphate; anion; buffer; catalase; chelate; citric acid; ferric ion; ferrous ferrozine; ferrous ion; ferrous quinolinate; ferrozine; glutamate receptor; hexaaquairon; hydrogen peroxide; hydroxide; hydroxyl radical; iron complex; iron derivative; n methyl dextro aspartic acid; phosphate; quinolinic acid; quinolinic acid derivative; reactive oxygen metabolite; receptor subtype; titanium; tryptophan; unclassified drug; article; autooxidation; brain disease; catalysis; chemical reaction; complex formation; concentration (parameters); controlled study; decomposition; dementia; disease association; electron spin resonance; Fenton reaction; Human immunodeficiency virus; macrophage; metabolite; neurotoxicity; oxidation; oxidation reduction reaction; pathogenesis; pH},
	publisher = {Harwood Academic Publishers GmbH},
	issn = {10715762},
	coden = {FRARE},
	pmid = {11378528},
	language = {English},
	abbrev_source_title = {Free Radic. Res.},
	type = {Article},
