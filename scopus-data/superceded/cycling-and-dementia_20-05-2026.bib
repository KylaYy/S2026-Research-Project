@ARTICLE{Cheriyan2022511,
	author = {Cheriyan, Riboy and Abraham, Joel and Sree Sankar, E. and Narayanan, Sandeep and Mathai, Reuben George},
	title = {Nemo: Energy Efficient Location Tracker for Dementia Patients Using LoRaWAN and Adaptive GPS Duty Cycling Strategies},
	year = {2022},
	journal = {EAI/Springer Innovations in Communication and Computing},
	pages = {511 - 521},
	doi = {10.1007/978-3-030-77528-5_27},
	url = {https://www.scopus.com/pages/publications/85120524041?origin=resultslist},
	affiliations = {Department of ECE, SAINTGITS College of Engineering, Kottayam, Kerala, India},
	abstract = {Dementia is one of the primary causes of dependency and disability among older people worldwide. In order to diminish the risk of wandering associated with dementia, portable GPS trackers are used by the patients. But most of these devices are plagued by either short-range or low-effective battery life not greater than 10 hours, thus becoming highly restrictive. At the same time, though techniques to make these devices more energy efficient are available in literature, many of them fail to provide sufficient accuracy required for continuous real-time location tracking of the patient. Therefore, in this paper, we propose a novel, small, and energy-efficient location tracker called Nemo that can be used as a wearable by effectively combining the novel LoRa protocol of communication, geofencing, and Adaptive GPS Duty Cycling strategies. The whole system consists of a LoRa-enabled GPS tracker as end node, a LoRaWAN gateway to relay the messages between the tracker and a central server, and also an Android/web application to receive real-time alerts. Further, the maximum range of communication and energy efficiency of the module at various environments is verified through comprehensive real-world experiments. © 2022, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
	author_keywords = {Dementia; GPS; Location tracker; LoRa},
	keywords = {Energy efficiency; Gateways (computer networks); Global positioning system; Neurodegenerative diseases; Tracking (position); Battery life; Central servers; Dementia patients; Duty-cycling; Energy efficient; Location tracker; Lora; Older People; Real-time location; WEB application; Location},
	correspondence_address = {R. Cheriyan; Department of ECE, SAINTGITS College of Engineering, Kottayam, Kerala, India; email: riboy.cherian@saintgits.org},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {25228595},
	language = {English},
