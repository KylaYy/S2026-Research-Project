@ARTICLE{Wang2026e47633,
	author = {Wang, Xiangbo and Liu, Yingli and Yin, Yuheng and Huang, Hui and Chen, Jie and Chen, Ziyi and Liu, Songlin and Xiao, Linxiao and Chen, Shan and Peng, Chenggen},
	title = {The effects of structured aerobic exercise and mind–body exercise on cognitive function in older adults with MCI: Systematic review and meta-analysis},
	year = {2026},
	journal = {Medicine (United States)},
	volume = {105},
	number = {10},
