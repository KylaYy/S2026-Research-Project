@ARTICLE{Kuller2001327,
	author = {Kuller, L.H.},
	title = {Hormone replacement therapy and coronary heart disease: A new debate},
	year = {2001},
	journal = {Cardiology Clinics},
	volume = {19},
	number = {2},
	pages = {327 - 341},
	doi = {10.1016/S0733-8651(05)70216-2},
	url = {https://www.scopus.com/pages/publications/0034980824?origin=resultslist},
	affiliations = {Department of Epidemiology, Graduate School of Public Health, University of Pittsburgh, Pittsburgh, PA 15261, 130 DeSoto Street, United States},
	abstract = {The role of HRT in preventing acute myocardial infarctions or in secondary prevention of acute myocardial infarctions is more contentious now than in the past. Ongoing clinical trials, such as the Women's Health Initiative and a similar trial in Great Britain, are comparing the benefits of estrogen in women with hysterectomy only and estrogen-progesterone and placebo in postmenopausal women and may provide more definitive answers about the risks and benefits of HRT. The results of these trials, however, will probably not be known for the next 4 to 5 years, especially if only a small or insignificant effect is seen. The best approach now before the results of these new studies is probably to consider estrogen or estrogen-progesterone therapy as a specific drug therapy for the possible prevention of coronary heart disease in the context of other available therapies. The HERS results suggest that HRT should not be used for the prevention of acute myocardial infarctions among women with pre-existing clinical cardiovascular disease. Other therapies, such as lipid-lowering drug therapies, aspirin, β-blockers, and antihypertensive therapies, are probably more efficacious in secondary prevention of coronary heart disease than estrogen or estrogen-progesterone. Estrogen or estrogen-progesterone therapy is likely to be beneficial in preventing acute myocardial infarctions for some women. Estrogen or estrogen-progesterone therapy may be useful in women who are at increased risk for coronary heart disease with moderately elevated risk factors, especially LDL-c. Women at increased risk can also be identified by various noninvasive methods of measuring atherosclerosis. More potent lipid-lowering drug therapies are probably preferred for women with high LDL-c levels, especially if they have significant coronary atherosclerosis and need to reduce their LDL-c levels to less than 100. Whether estrogen or estrogenprogesterone in combination with a lipid-lowering therapy may be preferential to lipid-lowering therapy alone is also undetermined. Similarly, fibrates may be the preferable drug or fibrates in combination with statins for women with relatively low HDL-c levels or high triglyceride levels (i.e., part of the insulin resistance syndrome). There are no solid trials of raising HDL-c and reducing risk for coronary heart disease among women. The trials in men are inconsistent but suggest lowering triglyceride levels with fibrates may be beneficial. Antihypertensive therapy is efficacious in both men and women in reducing risk for stroke, myocardial infarction, and congestive heart failure, Estrogen or estrogen-progesterone therapy has no effect on blood pressure levels. There is some suggestion that estrogen might improve large vessel compliance of blood vessels. Estrogen therapy has no apparent benefit in reducing the risk for stroke, consistent with little effect on decreasing blood pressure levels. Diabetes mellitus is a major risk factor for coronary heart disease among postmenopausal women. Estrogen or estrogen-progesterone has little effect on glucose-insulin metabolism. A reduction in LDL-c and blood pressure as well as the use of aspirin therapy among diabetics, reduces their risk for coronary heart disease and stroke. There is no evidence that estrogen or estrogen-progesterone therapy is contraindicated among diabetic patients or reduces risk for microvascular or macrovascular disease. The progression of atherosclerosis to clinical disease has a long incubation period. During the first 10 to 15 years after menopause (i.e., the cessation of menses), risk for coronary heart disease (i.e., myocardial infarction and coronary heart disease deaths) is similar to the incidence of breast cancer (both approximately 4000 to 5000 per year). After age 60 to 65, the risk for coronary heart disease increases substantially among women, but the rise in breast cancer is much less steep. Among older women, heart disease and stroke have a much higher incidence than breast cancer and cause more morbidity. If HRT were started at the time of the changes in menstrual cycling (i.e., around the menopause), it would have to be continued at least 30 to 40 years to have any major effects on overall cardiovascular morbidity and mortality among women. It is possible that HRT has benefits in relation to the acute process, such as acute thrombosis, or by stabilization of plaques, or perhaps by increased fibrinolysis. HRT begun later in the postmenopause at a time when women are at higher risk (i.e., age 60 to 65) might be successful. There is no evidence to support the effects of starting HRT in older women. The results of the Women's Health Initiative may provide information regarding the use of HRT in older women. It is fairly likely that, in the future, noninvasive methods of measuring atherosclerosis will be available to monitor progression of atherosclerosis and select therapies based on progression and on changing characteristics of plaques. Such therapies could be tailored to the individual patient's risk for atherosclerosis and acute myocardial infarction. Newer therapies, such as SERMs, may have equal benefits in reducing CHD as compared with estrogen and estrogen-progesterone and may reduce the risk for breast cancer as well as other cancers. They could replace estrogen and estrogen-progesterone as a potential drug choice. There is no evidence that SERMs reduce the risk for coronary heart disease. The use of estrogen therapy and estrogen or estrogen-progesterone therapy in the prevention and treatment of osteoporosis and osteoporotic fractures is well recognized. Some physicians believe that the benefits of long-term estrogen or estrogen-progesterone therapy for the treatment and prevention of osteoporotic fractures would be an indication, regardless of whether there is any benefit in the prevention of coronary heart disease. The choice of therapies in the prevention of osteoporosis probably depends on the risk benefit with regard to breast cancer, uterine cancer, and venous thrombosis if there is no benefit for coronary heart disease. It is possible that estrogen or estrogen-progesterone therapy may reduce the risk for dementia, especially Alzheimer's disease, among older women. Most older women who have Alzheimer's disease are probably in their 80s or older. No effective preventive therapies for Alzheimer's disease exist at present. If estrogen or estrogen-progesterone therapy prevents or delays onset of dementia, therapy may be indicated for more postmenopausal women. The critical question is whether the therapy has to begin at the time of the menopause or during the perimenopause or at older ages. Clinical trials are currently evaluating the use of estrogen and estrogen-progesterone therapy in the prevention and treatment of dementia.},
