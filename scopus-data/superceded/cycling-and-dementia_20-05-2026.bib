@ARTICLE{Donath2017,
	author = {Donath, Lars and Ludyga, Sebastian and Hammes, Daniel and Rossmeissl, Anja and Andergassen, Nadin and Zahner, Lukas and Faude, Oliver},
	title = {Absolute and relative reliability of acute effects of aerobic exercise on executive function in seniors},
	year = {2017},
	journal = {BMC Geriatrics},
	volume = {17},
	number = {1},
	pages = {},
	doi = {10.1186/s12877-017-0634-x},
