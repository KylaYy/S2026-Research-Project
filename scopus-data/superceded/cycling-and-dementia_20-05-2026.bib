	correspondence_address = {D. Xue; Department of Nursing, Gongli Hospital of Shanghai Pudong New Area, Shanghai, 219 Miao Pu Road, 200135, China; email: xuedandan_nursing@163.com},
	publisher = {Elsevier Inc.},
